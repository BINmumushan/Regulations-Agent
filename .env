# 聊天模型 API 配置（DeepSeek 或任意 OpenAI 兼容服务）
OPENAI_API_KEY=sk-06ac00964c904481aa61a118bcc051f3
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 向量化配置：local 使用本机 fastembed 模型，openai 使用 OpenAI 兼容 embedding 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索参数
TOP_K=10
SCORE_THRESHOLD=0.05
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVE_LIMIT=24
SUMMARY_RETRIEVE_LIMIT=200
SUMMARY_FULL_SOURCE_MAX=120
SUMMARY_SEED_LIMIT=120

# 内部演示试用版访问密码（留空表示不启用密码门）
DEMO_PASSWORD=123

# 扫描 PDF 自动 OCR：设为 0 可关闭；PDF_OCR_DPI 控制识别分辨率
# PDF_OCR_ENABLED=1
# PDF_OCR_DPI=200
